{
  "name": "pythonai-inline-chat",
  "displayName": "PythonAI Inline Chat",
  "description": "Inline Chat and Refactoring powered by local ASCS/Ollama.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onCommand:pythonai.inlineChat"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pythonai.inlineChat",
        "title": "PythonAI: Inline Chat / Refactor"
      }
    ],
    "keybindings": [
      {
        "command": "pythonai.inlineChat",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      }
    ]
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
