OLLAMA_BASE_URL=https://api.example.com/
OLLAMA_MODEL=gemma-4-31b-it
OLLAMA_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_API_KEY=sk-example-litellm-virtual-key
LAYA_MODEL_DIR=models/laya-multilingual
MEMORY_DB_PATH=memory/memory.db
COMMUNICATION_DB_PATH=communication/communication.db
COMMUNICATION_HOST=127.0.0.1
COMMUNICATION_PORT=8000
COMMUNICATION_ACCESS_LOG=1

# Communication adapters
COMM_ALLOWED_SENDERS=telegram:123456789
COMM_ADMIN_SENDERS=telegram:123456789
TELEGRAM_BOT_TOKEN=123456789:AAExampleTelegramBotToken
TELEGRAM_WEBHOOK_SECRET=example-telegram-webhook-secret
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_POLL_IDLE_SLEEP=0.2

# LiteLLM Provider Quota / Rate Limit Configuration (Recommended settings in LiteLLM config.yaml)
# max_requests_per_minute: 60
# max_tokens_per_minute: 100000
