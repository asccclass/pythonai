OLLAMA_BASE_URL=https://api.example.com/
OLLAMA_MODEL=gemma-4-31b-it
# Per-image vision token reservation; Base64 transport bytes are not text tokens.
# Override per model with AGENT_MODEL_CAPABILITIES: {"model-id":{"image_input_tokens":8192}}.
AGENT_MODEL_IMAGE_TOKENS=8192
OLLAMA_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_API_KEY=sk-example-litellm-virtual-key
AGENT_WORKSPACE_ROOT=workspace
LAYA_MODEL_DIR=models/laya-multilingual
MEMORY_DB_PATH=memory/memory.db
COMMUNICATION_DB_PATH=communication/communication.db
COMMUNICATION_HOST=127.0.0.1
COMMUNICATION_PORT=8000
COMMUNICATION_ACCESS_LOG=1
AGENT_API_TOKENS={}
# Authoritative private JSON role mapping; missing/invalid roles default viewer.
# When empty, only exact communication identities in COMM_ADMIN_SENDERS become admin.
ROLES_CONFIG=
COMM_PROJECT=default
AGENT_PROJECT_WORKSPACES={}
# AGENT_TENANT_ROOT should be outside model-controlled workspaces.
AGENT_TENANT_ROOT=

# Communication adapters
COMM_WEBHOOK_MODE=production
COMM_WEBHOOK_MAX_AGE_SECONDS=300
COMM_ALLOWED_SENDERS=telegram:123456789
# Admission allowlist above does not grant roles; this admin list applies only without ROLES_CONFIG.
COMM_ADMIN_SENDERS=telegram:123456789
TELEGRAM_BOT_TOKEN=123456789:AAExampleTelegramBotToken
TELEGRAM_WEBHOOK_SECRET=example-telegram-webhook-secret
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_POLL_IDLE_SLEEP=0.2
TELEGRAM_POLL_ERROR_SLEEP=5
# Bounded handoff retry budget per process lifetime (0..3).
TELEGRAM_POLL_CONFLICT_RETRIES=2
# Optional 1..300 seconds; empty defaults to max(5, poll timeout + 5, error sleep).
TELEGRAM_POLL_CONFLICT_SLEEP=
# Optional: use one shared lock directory for polling processes on the same host.
AGENT_TELEGRAM_POLL_LOCK_DIR=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# LiteLLM Provider Quota / Rate Limit Configuration (Recommended settings in LiteLLM config.yaml)
# max_requests_per_minute: 60
# max_tokens_per_minute: 100000
# Upper bound on model execution rounds; task request budget further caps this and reserves final/judge headroom.
AGENT_MAX_ITERATIONS=32
# Optional Temporal M0 read-only backend. Existing tasks keep their original backend.
# Install agent_execution/temporal_backend/requirements.txt and start the explicit Worker first.
AGENT_EXECUTION_BACKEND=sqlite
AGENT_TEMPORAL_ADDRESS=127.0.0.1:7233
AGENT_TEMPORAL_NAMESPACE=pythonai-dev
AGENT_TEMPORAL_ACTIVITY_CONCURRENCY=2
COMPANION_WS_TOKENS="desktop-token:andy"
ROLES_CONFIG=C:\\Users\\andyl\\Go\\pythonai\\config\\roles.json
