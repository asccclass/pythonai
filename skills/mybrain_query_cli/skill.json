{
  "name": "mybrain_query_cli",
  "description": "Query the local MyBrain knowledge base by running the bundled mybrain.exe CLI directly.",
  "triggers": [
    "mybrain",
    "my brain",
    "local knowledge base",
    "my local knowledge base",
    "我的筆記",
    "知識庫",
    "本地資料",
    "本地知識庫",
    "本地資料庫",
    "wiki",
    "過往筆記",
    "command-line access to MyBrain"
  ],
  "inputs": {
    "type": "object",
    "properties": {
      "question": {
        "type": "string",
        "description": "The question to ask MyBrain."
      }
    },
    "required": [
      "question"
    ]
  },
  "allowed_tools": [
    "run_command"
  ],
  "execution": {
    "mode": "tool_sequence",
    "steps": [
      {
        "tool": "run_command",
        "args": {
          "command": [
            "powershell",
            "-NoProfile",
            "-Command",
            "Set-Location -LiteralPath 'skills\\mybrain_query_cli\\scripts'; .\\mybrain.exe --query $args[0]",
            "{{question}}"
          ]
        }
      }
    ]
  }
}
